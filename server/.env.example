# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/docqa

# Groq API key — free at https://console.groq.com  (key starts with gsk_)
GROQ_API_KEY=your_groq_key_here

# Groq model — llama-3.3-70b-versatile is the best free option
# Other options: llama-3.1-8b-instant (faster), mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Port the Express server listens on
PORT=5000
