# MongoDB Atlas connection string (use Atlas for Vercel — NOT localhost)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/docqa?retryWrites=true&w=majority

# Groq API key — free at https://console.groq.com  (key starts with gsk_)
GROQ_API_KEY=your_groq_key_here

# Groq model — llama-3.3-70b-versatile is the best free option
# Other options: llama-3.1-8b-instant (faster), mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Your deployed Vercel frontend URL (set this on Vercel dashboard → Environment Variables)
# Example: https://askmydoc.vercel.app
CLIENT_URL=https://your-app.vercel.app

# Port the Express server listens on (not used on Vercel serverless)
PORT=5000
